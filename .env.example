# Required for design-brief extraction and image generation. Keep this value server-side only.
GRSAI_API_KEY=

# GRSai is OpenAI-compatible. Gemini Flash Lite is the low-latency default.
GRSAI_BASE_URL=https://grsaiapi.com
GRSAI_MODEL=gemini-3.1-flash-lite

# Image generation uses gpt-image-2.5-sunburst through GRSai at 2K/high quality.
# Ensure this key has sufficient GRSai image-generation credits.

# Public page identity
NEXT_PUBLIC_CLONE_NAME=张文杰
NEXT_PUBLIC_CLONE_TAGLINE=视觉设计 · AI 设计 · 海报与详情页

# Optional: enables the Enterprise WeChat callback route at /api/wecom.
# Set all three values when configuring encrypted callbacks in the WeCom admin.
WECHAT_WORK_TOKEN=
WECHAT_WORK_ENCODING_AES_KEY=
WECHAT_WORK_CORP_ID=
