# Required for chat. Keep this value server-side only.
GRSAI_API_KEY=

# GRSai is OpenAI-compatible. This clone uses the same GPT-6 model as 小蝶.
GRSAI_BASE_URL=https://grsaiapi.com
GRSAI_MODEL=gpt-6-astra

# Public page identity
NEXT_PUBLIC_CLONE_NAME=Richart J
NEXT_PUBLIC_CLONE_TAGLINE=视觉设计师 · AI 自动化 · 数字产品

# Optional: enables the Enterprise WeChat callback route at /api/wecom.
# Set all three values when configuring encrypted callbacks in the WeCom admin.
WECHAT_WORK_TOKEN=
WECHAT_WORK_ENCODING_AES_KEY=
WECHAT_WORK_CORP_ID=
